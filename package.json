{
  "name": "international-finance-lyceum",
  "version": "1.0.0",
  "private": true,
  "description": "Official website of Academic Lyceum at Tashkent State University of Economics «International Finance»",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "admin:create": "tsx scripts/create-admin.ts",
    "backup:create": "bash scripts/backup.sh",
    "backup:restore": "bash scripts/restore.sh",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,md,json}\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@prisma/client": "^5.20.0",
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.4.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "jose": "^5.10.0",
    "lucide-react": "^0.439.0",
    "multer": "^1.4.5-lts.1",
    "next": "^14.2.13",
    "next-intl": "^3.19.0",
    "next-sitemap": "^4.2.3",
    "postcss": "^8.4.45",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.5",
    "slugify": "^1.6.6",
    "tailwind-merge": "^2.5.2",
    "tailwindcss": "^3.4.10",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/multer": "^1.4.12",
    "@types/sharp": "^0.31.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.13",
    "prettier": "^3.3.3",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
