# ===========================================
# PRODUCTION environment — fill in and rename to .env
# ===========================================

# Application
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://lyceum.example.com

# PostgreSQL (use the same POSTGRES_USER/PASSWORD as docker-compose.yml)
POSTGRES_USER=lyceum_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD
POSTGRES_DB=lyceum_db
DATABASE_URL=postgresql://lyceum_user:CHANGE_ME_STRONG_RANDOM_PASSWORD@postgres:5432/lyceum_db?schema=public

# Admin Panel — initial credentials (used only on first `prisma db seed`)
# ⚠️ CHANGE THESE BEFORE GOING LIVE
ADMIN_DEFAULT_EMAIL=admin@lyceum.uz
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_DEFAULT_NAME=Site Administrator

# Session signing secret — generate with: openssl rand -hex 32
NEXTAUTH_SECRET=CHANGE_ME_HEX_32_BYTES

# Image storage — local filesystem (Cloudinary doesn't work in this region)
STORAGE_DRIVER=local

# Localization
NEXT_PUBLIC_DEFAULT_LOCALE=ru
NEXT_PUBLIC_SUPPORTED_LOCALES=ru,uz,en

# Backups (optional)
BACKUP_PATH=/var/backups/lyceum
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_RETENTION_DAYS=30
