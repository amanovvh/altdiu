# ===========================================
# Application
# ===========================================
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===========================================
# Database (PostgreSQL)
# ===========================================
DATABASE_URL="postgresql://lyceum_user:strong_password@localhost:5432/lyceum_db?schema=public"

# ===========================================
# Admin Panel — initial credentials
# ===========================================
# Used only on first `npm run db:seed`. Change the password after first login!
ADMIN_DEFAULT_EMAIL=admin@lyceum.uz
ADMIN_DEFAULT_PASSWORD=change_me_immediately
ADMIN_DEFAULT_NAME=Site Administrator

# ===========================================
# Authentication / Session signing
# ===========================================
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=generate_a_random_32_byte_hex_string

# ===========================================
# Cloudinary (Image Storage)
# ===========================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=lyceum

# ===========================================
# Backups
# ===========================================
BACKUP_PATH=/var/backups/lyceum
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_RETENTION_DAYS=30

# ===========================================
# Localization
# ===========================================
NEXT_PUBLIC_DEFAULT_LOCALE=ru
NEXT_PUBLIC_SUPPORTED_LOCALES=ru,uz,en
